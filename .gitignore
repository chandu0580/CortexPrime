# Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.db

# Environment variables — never commit real values.
# Covers every variant (.env.local, .env.production, nested service envs);
# the *.example templates stay tracked because they hold only empty placeholders.
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# TLS certificates — never commit private keys
*.pem
*.key
*.crt
*.p12
*.pfx
infra/nginx/certs/cert.pem
infra/nginx/certs/key.pem

# VS Code
.vscode/

# Node.js
node_modules/
.next/
dist/
build/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Testing / coverage
.coverage
htmlcov/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Temporary files
temp/
tmp/

# Docker
*.pid

# LangChain / AI cache
.cache/

