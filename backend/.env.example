

# =========================================================
# CORTEXPRIME PLATFORM — Environment Template
# Copy to backend/.env and fill in all values.
# NEVER commit backend/.env to version control.
# =========================================================

ENVIRONMENT=development        # development | staging | production
DEBUG=true                     # false in production

APP_NAME=CortexPrime
APP_VERSION=1.0.0


# =========================================================
# OPENAI API (FALLBACK / OPTIONAL)
# =========================================================

OPENAI_API_KEY=


# =========================================================
# AZURE OPENAI
# =========================================================

AZURE_OPENAI_API_KEY=

AZURE_OPENAI_ENDPOINT=


AZURE_OPENAI_API_VERSION=

# =========================================================
# MODEL ROUTING
# USE EXACT AZURE DEPLOYMENT NAMES
# =========================================================

MODEL_ORCHESTRATOR=

MODEL_RUNTIME_FAST=

MODEL_PLANNER=

MODEL_CRITIC=

MODEL_REALTIME=

MODEL_REALTIME_FAST=

MODEL_EMBEDDING_PRIMARY=

MODEL_EMBEDDING_FAST=

MODEL_TTS=

MODEL_GENERAL=

MODEL_NANO_FAST=


# =========================================================
# API SERVER
# =========================================================

API_HOST=

API_PORT=


# =========================================================
# WEBSOCKET RUNTIME
# =========================================================

WEBSOCKET_HOST=

WEBSOCKET_PORT=


# =========================================================
# MEMORY SYSTEM
# =========================================================

VECTOR_DB_PROVIDER=

VECTOR_DB_PATH=


# =========================================================
# AUTONOMOUS EXECUTION SYSTEMS
# =========================================================

MAX_AUTONOMOUS_ITERATIONS=

ENABLE_REFLECTION_ENGINE=

ENABLE_MEMORY_PERSISTENCE=

ENABLE_AGENT_OPTIMIZATION=


# =========================================================
# OBSERVABILITY & TELEMETRY
# =========================================================

ENABLE_TELEMETRY=

ENABLE_RUNTIME_LOGS=

ENABLE_AGENT_TRACING=

ENABLE_COGNITION_TRACING=


# =========================================================
# SAFETY & GOVERNANCE
# =========================================================

ENABLE_EXECUTION_VALIDATION=

ENABLE_AUDIT_LOGGING=

ENABLE_PERMISSION_SYSTEM=

ENABLE_HUMAN_OVERRIDE=


# =========================================================
# COMPUTER AGENT
# =========================================================

ENABLE_COMPUTER_AGENT=

ENABLE_BROWSER_AGENT=

ENABLE_OCR=


# =========================================================
# VOICE RUNTIME
# =========================================================

ENABLE_VOICE_AGENT=

ENABLE_REALTIME_RUNTIME=

ENABLE_TTS=

ENABLE_STT=

# =========================================================
# VOICE V2  (LiveKit + Pipecat + Deepgram)
# Set these to enable the production voice runtime.
# LiveKit Cloud: https://livekit.io/cloud
# Deepgram:      https://console.deepgram.com
# =========================================================

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=


# =========================================================
# DEVELOPMENT FLAGS
# =========================================================

ENABLE_DEBUG_LOGS=

ENABLE_EXPERIMENTAL_AGENTS=


# =========================================================
# AUTHENTICATION  (JWT)
# Set CORTEX_PASSWORD before any deployment.
# JWT_SECRET_KEY must be at least 32 chars.
# =========================================================

# =========================================================
# AUTHENTICATION  (JWT — Phase 2)
# Set CORTEX_PASSWORD_HASH before any deployment.
# Generate hash: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASS', bcrypt.gensalt()).decode())"
# JWT_SECRET_KEY must be at least 32 chars.
# =========================================================

CORTEX_USER=
CORTEX_PASSWORD=
# bcrypt hash of CortexPrime2026! — use this in production, remove CORTEX_PASSWORD
CORTEX_PASSWORD_HASH=

JWT_SECRET_KEY=
JWT_REFRESH_SECRET=
JWT_ALGORITHM=
JWT_EXPIRE_MINUTES=
JWT_REFRESH_EXPIRE_H=

# =========================================================
# CORS
# Comma-separated list of allowed frontend origins
# =========================================================

CORS_ORIGINS=

# =========================================================
# TAVILY SEARCH  (Live Research Runtime)
# https://app.tavily.com
# =========================================================

TAVILY_API_KEY=
TAVILY_MAX_RESULTS=
TAVILY_SEARCH_TIMEOUT=
RESEARCH_TOP_K=
# --- Generated by deploy script 2026-06-07 ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
NEO4J_PASSWORD=

# --- Generated passwords (2026-06-07) ---
