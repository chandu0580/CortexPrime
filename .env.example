# ==============================================================
# CORTEXPRIME — Environment Configuration Template
#
# Copy to backend/.env and fill in real values before running.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_hex(64))"
#
# NEVER commit .env to source control.
# ==============================================================

# --------------------------------------------------------------
# LLM PROVIDERS  (at least OPENAI_API_KEY required)
# Rotate: revoke key at provider dashboard, issue new, update here.
# --------------------------------------------------------------
OPENAI_API_KEY=                        # https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=                     # https://console.anthropic.com/
GOOGLE_API_KEY=                        # https://aistudio.google.com/app/apikey

# --------------------------------------------------------------
# AZURE OPENAI
# Rotate: Azure portal → your resource → Keys & Endpoint
# --------------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --------------------------------------------------------------
# GITHUB  — Webhook signing secret (server-side only)
# Must match the "Secret" configured on the repo's webhook in
# GitHub Settings → Webhooks. GitHub proves it knows this secret via
# the X-Hub-Signature-256 HMAC header — it never sends the secret
# itself, so this is never read from an incoming request.
# --------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=                  # generate with: python -c "import secrets; print(secrets.token_hex(32))"

# --------------------------------------------------------------
# GITLAB CI  — Webhook token (server-side only)
# Must match the "Secret token" configured on the project's webhook in
# GitLab Settings → Webhooks. Unlike GitHub, GitLab sends this value
# verbatim in the X-Gitlab-Token header rather than proving knowledge of
# it via HMAC — never log or echo it back.
# --------------------------------------------------------------
GITLAB_WEBHOOK_SECRET=                  # generate with: python -c "import secrets; print(secrets.token_hex(32))"

# Optional — set to this backend's "owner/repo" string to have it emit
# standard-convention http_requests_total / http_request_duration_seconds
# metrics labeled service=<value>, so enterprise_deploy_regression_detector
# can monitor this backend's own deploys. Leave unset for a normal deploy
# (no self-monitoring).
DEPLOY_TRACKED_SERVICE_NAME=

# --------------------------------------------------------------
# TAVILY  — Web Research
# Rotate: https://app.tavily.com/home → API Keys
# --------------------------------------------------------------
TAVILY_API_KEY=                        # tvly-...

# --------------------------------------------------------------
# DEEPGRAM  — Speech-to-Text
# Rotate: https://console.deepgram.com/ → API Keys
# --------------------------------------------------------------
DEEPGRAM_API_KEY=

# --------------------------------------------------------------
# LIVEKIT  — Real-time Voice
# Rotate: https://cloud.livekit.io/ → your project → Settings → Keys
# --------------------------------------------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://<project>.livekit.cloud

# --------------------------------------------------------------
# JWT  — Auth Tokens
# Rotate: generate new secrets, restart backend (existing sessions invalidated).
# python -c "import secrets; print(secrets.token_hex(64))"
# --------------------------------------------------------------
JWT_SECRET_KEY=                        # REQUIRED — min 32 chars
JWT_REFRESH_SECRET=                    # REQUIRED — different from JWT_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_H=168

# --------------------------------------------------------------
# CORTEXPRIME AUTH CREDENTIALS
# --------------------------------------------------------------
CORTEX_USER=admin
# Bcrypt hash recommended — generate:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
CORTEX_PASSWORD_HASH=                  # $2b$12$...
# CORTEX_PASSWORD=                     # Plaintext fallback — local dev only

# --------------------------------------------------------------
# BACKEND
# --------------------------------------------------------------
BACKEND_PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
AUTH_DISABLED=false                    # NEVER true in production
REVOCATION_FAIL_OPEN=false             # NEVER true in production

# --------------------------------------------------------------
# FRONTEND
# --------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# --------------------------------------------------------------
# POSTGRESQL + pgvector  — AI Memory Store
# --------------------------------------------------------------
POSTGRES_HOST=cortex-postgres
POSTGRES_PORT=5432
POSTGRES_USER=cortex
POSTGRES_PASSWORD=                     # REQUIRED — no default
POSTGRES_DB=cortexdb

# --------------------------------------------------------------
# REDIS  — Session Store + Cognition Cache
# --------------------------------------------------------------
REDIS_HOST=cortex-redis
REDIS_PORT=6379
REDIS_PASSWORD=                        # REQUIRED if Redis auth enabled

# --------------------------------------------------------------
# RABBITMQ  — Async Orchestration Messaging
# --------------------------------------------------------------
RABBITMQ_HOST=cortex-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=cortex
RABBITMQ_PASSWORD=                     # REQUIRED — no default
RABBITMQ_VHOST=cortex

# --------------------------------------------------------------
# NEO4J  — Cognitive Graph Engine
# --------------------------------------------------------------
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=                        # REQUIRED — no default
# Memory tuning (adjust for your host)
NEO4J_PAGE_CACHE=256M
NEO4J_HEAP_INIT=256M
NEO4J_HEAP_MAX=512M
